generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//time created, allocated jikantai in minutes, title, details, selectable subpoints
model Todo {
  id         Int     @id @default(autoincrement())
  title      String  
  details    String?
  bullets    Bullet[]
  date      DateTime @default(now())
  slot      Slot?    @relation(fields: [slotId], references: [id])
  slotId    Int?
} 

model Bullet {
  id         Int      @id @default(autoincrement())
  name       String
  status     Boolean  @default(false)
  todoId     Int
  todo       Todo     @relation(fields: [todoId], references: [id])
}

enum SlotType {
  FREE
  CUSTOM
}

model Slot {
  id         Int      @id @default(autoincrement())
  type       SlotType @default(FREE)
  designLen  Int?
  actualLen  Int?
  todos      Todo[]
}

