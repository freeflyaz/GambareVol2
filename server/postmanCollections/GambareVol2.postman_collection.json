	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"pm.variables.set(\"title\", \"Learn about Postman pre-request scripting\");\r",
					"pm.variables.set(\"details\", \"Simple, single API pre-request scripting\");\r",
					"\r",
					"if (!pm.environment.get('skipMainRequest')) {\r",
					"    pm.sendRequest({\r",
					"        url: 'http://localhost:8000/addTodo',\r",
					"        method: 'POST',\r",
					"        header: {\r",
					"            'Content-Type': 'application/json'\r",
					"        },\r",
					"        body: {\r",
					"            mode: 'raw',\r",
					"            raw: JSON.stringify({\r",
					"                title: \"Learn about Postman pre-request scripting\",\r",
					"                details: \"Simple, single API pre-request scripting\"\r",
					"            })\r",
					"        }\r",
					"    }, function (err, res) {\r",
					"        if (err) {\r",
					"            console.log('Error:', err);\r",
					"        } else {\r",
					"            console.log('Response:', res.json());\r",
					"        }\r",
					"\r",
					"       \r",
					"        pm.environment.set('skipMainRequest', true);\r",
					"    });\r",
					"}\r",
					"\r",
