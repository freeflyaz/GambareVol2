	"item": [
		{
			"name": "/addTodo",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"status code is 200\", ()=>{\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"pm.test(\"Response  contains the new todo\", ()=>{\r",
							"    const todo = pm.response.json();\r",
							"    console.log(\"todo\", todo)\r",
							"    pm.expect(todo).to.be.an(\"object\").that.has.property(\"msg\", \"new todo successfully created\");\r",
							"    pm.expect(todo).to.be.an(\"object\").that.has.property(\"data\");\r",
							"    pm.expect(todo.data).to.have.property(\"title\", \"Learn about Postman pre-request scripting\");\r",
							"    pm.expect(todo.data).to.have.property(\"details\", \"Simple, single API pre-request scripting\");\r",
							"});\r",
							"\r",
							""
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"title\": \"Learn about Postman pre-request scripting\",\r\n    \"details\": \"Simple, single API pre-request scripting\"\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "localhost:8000/addTodo",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
